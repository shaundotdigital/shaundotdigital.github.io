---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

// The last thing on every page. It shares the black block with SiteFooter so the
// two read as one ending, but this part is the sign-off and contact, not the footer.

const email = "shaun.skeen@icloud.com";

const links = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/shaunskeen" },
  { label: "Letterboxd", href: "https://letterboxd.com/shaundotdigital/" },
  { label: "GitHub", href: "https://github.com/shaundotdigital" },
  { label: "Bluesky", href: "https://bsky.app/profile/shaundotdigital.bsky.social" },
];
---

<section id="contact" class="bg-ink text-paper">
  <div class="container-default pt-24 pb-16 md:pt-16">
    <Logo variant="outline-reversed" class="text-3xl" />

    <!-- Kept smaller than the hero headline, so the page opens louder than it closes -->
    <h2 class="mt-10 max-w-2xl text-[2rem] leading-[1.2] sm:text-4xl">
      That&rsquo;s the end of the page. Say hello if you want to talk testing, content or films.
    </h2>

    <div class="mt-12 flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <a
        href={`mailto:${email}`}
        class="button-primary self-start"
      >
        {email}
        <Icon name="arrow-right" class="size-5" />
      </a>

      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {links.map((link) => (
          <li>
            <a href={link.href} class="link active:text-paper/70">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
