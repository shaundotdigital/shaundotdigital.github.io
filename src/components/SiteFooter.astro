---
import { OPT_OUT_KEY } from "./Analytics.astro";
import footer from "../data/footer.json";

// The words and links live in src/data/footer.json, which Pages CMS edits.
const stack = footer.builtWith;
const footerLink = "link inline-flex min-h-11 min-w-11 items-center active:text-paper/60";
---

<footer class="theme-inverse bg-ink font-sans text-paper/80">
  <div class="container-default flex flex-col gap-4 border-t py-8 border-paper/15 text-sm md:flex-row md:items-start md:justify-between">
    <!-- Each link stands on its own, at least 44px tall and wide, so it is easy to tap -->
    <div>
      <p>&copy; {new Date().getFullYear()} {footer.copyright}</p>
      <ul class="flex flex-wrap items-center gap-x-4">
        <li>Built with</li>
        {stack.map((item) => (
          <li>
            <a href={item.url} target="_blank" rel="noopener" class={footerLink}>{item.label}</a>
          </li>
        ))}
      </ul>
      <p class="flex flex-wrap items-center gap-x-4">
        Film data from
        <a href="https://letterboxd.com" target="_blank" rel="noopener" class={footerLink}>Letterboxd</a>
      </p>
    </div>

    <div class="max-w-md">
      <p>{footer.analyticsNotice}</p>
      <div class="flex flex-wrap items-center gap-x-4">
        <a href="/privacy" class={footerLink}>{footer.privacyLink}</a>
        <button
          type="button"
          data-analytics-toggle
          data-track-ignore
          data-key={OPT_OUT_KEY}
          class:list={[footerLink, "cursor-pointer"]}
        >
          Opt out of analytics
        </button>
        <span data-analytics-status role="status"></span>
      </div>
    </div>
  </div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-analytics-toggle]");
  const status = document.querySelector<HTMLElement>("[data-analytics-status]");

  if (button) {
    const key = button.dataset.key ?? "analytics-opt-out";

    const isOptedOut = () => {
      try {
        return localStorage.getItem(key) === "1";
      } catch {
        return false;
      }
    };

    const render = () => {
      button.textContent = isOptedOut() ? "Opt back in to analytics" : "Opt out of analytics";
    };

    button.addEventListener("click", () => {
      const optOut = !isOptedOut();
      try {
        if (optOut) localStorage.setItem(key, "1");
        else localStorage.removeItem(key);
      } catch {
        if (status) status.textContent = "Your browser blocked saving this choice.";
        return;
      }
      render();
      if (status) {
        status.textContent = optOut
          ? "Done. Analytics is off for you from the next page load."
          : "Done. Analytics is back on from the next page load.";
      }
    });

    render();
  }
</script>
