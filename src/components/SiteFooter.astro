---
import { OPT_OUT_KEY } from "./Analytics.astro";

// What the site is built with, shown under the copyright.
const stack = [
  { label: "Astro", href: "https://astro.build" },
  { label: "Tailwind CSS", href: "https://tailwindcss.com" },
  { label: "Space Grotesk", href: "https://fonts.google.com/specimen/Space+Grotesk" },
  { label: "GitHub Pages", href: "https://pages.github.com" },
];
---

<footer class="theme-inverse bg-ink font-sans text-paper/80">
  <div class="container-default flex flex-col gap-4 border-t py-8 border-paper/15 text-sm md:flex-row md:items-start md:justify-between">
    <div class="space-y-2">
      <p>&copy; {new Date().getFullYear()} Shaun Digital</p>
      <p>
        Built with{" "}
        {stack.map((item, i) => (
          <>
            <a href={item.href} target="_blank" rel="noopener" class="link active:text-paper/60">{item.label}</a>
            {i < stack.length - 2 ? ", " : i === stack.length - 2 ? " and " : "."}
          </>
        ))}
        {" "}Film data from{" "}
        <a href="https://letterboxd.com" target="_blank" rel="noopener" class="link active:text-paper/60">Letterboxd</a>.
      </p>
    </div>

    <div class="max-w-full">
      <p>
        This site uses Google Analytics to count visits and see which pages get read, so I can improve it.
        It doesn&rsquo;t use advertising features, and it&rsquo;s switched off for visitors in the EU.{" "}
        <a href="/privacy" class="link active:text-paper/60">Privacy</a>
      </p>
      <p class="mt-2">
        <button
          type="button"
          data-analytics-toggle
          data-track-ignore
          data-key={OPT_OUT_KEY}
          class="link cursor-pointer active:text-paper/60"
        >
          Opt out of analytics
        </button>
        <span data-analytics-status role="status" class="ml-2"></span>
      </p>
    </div>
  </div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-analytics-toggle]");
  const status = document.querySelector<HTMLElement>("[data-analytics-status]");

  if (button) {
    const key = button.dataset.key ?? "analytics-opt-out";

    const isOptedOut = () => {
      try {
        return localStorage.getItem(key) === "1";
      } catch {
        return false;
      }
    };

    const render = () => {
      button.textContent = isOptedOut() ? "Opt back in to analytics" : "Opt out of analytics";
    };

    button.addEventListener("click", () => {
      const optOut = !isOptedOut();
      try {
        if (optOut) localStorage.setItem(key, "1");
        else localStorage.removeItem(key);
      } catch {
        if (status) status.textContent = "Your browser blocked saving this choice.";
        return;
      }
      render();
      if (status) {
        status.textContent = optOut
          ? "Done. Analytics is off for you from the next page load."
          : "Done. Analytics is back on from the next page load.";
      }
    });

    render();
  }
</script>
