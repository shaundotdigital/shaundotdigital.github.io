---
// Placeholder content for the most recent role.
const role = {
  company: "Brakes / Sysco",
  title: "Digital Optimisation Executive",
  summary:
    "Placeholder summary. A few lines on what you own in this role, what you improved and the result it had for the business.",
  tags: [
    "A/B testing",
    "Analytics",
    "CRO",
    "UX",
    "Content optimisation",
    "Campaigns",
    "SEO",
    "Stakeholder management",
  ],
};
---

<section id="recent" class="bg-paper-raised text-ink">
  <div class="container-default py-20">
    <h2 class="max-w-md text-2xl tracking-tight md:text-3xl">
      <span class="text-neutral-500">I currently</span> work at {role.company},{" "}
      <span class="text-neutral-500">improving the</span> online customer experience.
    </h2>

    <!-- Logo placeholder -->
    <div class="mt-10 flex h-10 w-36 items-center justify-center rounded-lg border border-dashed border-neutral-400 text-xs text-neutral-600">
      Logo
    </div>

    <h3 class="mt-6 text-lg">{role.title}</h3>
    <p class="mt-2 max-w-md text-sm leading-relaxed text-neutral-600">{role.summary}</p>

    <ul class="mt-6 flex max-w-md flex-wrap gap-2">
      {role.tags.map((tag) => (
        <li class="rounded-full bg-ink/5 px-3 py-1 text-xs tracking-wide text-neutral-700 uppercase">{tag}</li>
      ))}
    </ul>
  </div>
</section>
