---
import Icon from "../Icon.astro";
import { getLetterboxd, posterAt } from "../../lib/letterboxd";

const roles = ["Digital Optimisation", "UX and CRO", "Content", "Web and Print"];

// The "now" card uses the latest film from the same Letterboxd data as the films section.
const { recent } = await getLetterboxd();
const lastWatched = recent[0];

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const shortDate = (iso: string) => {
  const [, month, day] = iso.split("-").map(Number);
  return `${day} ${months[month - 1]}`;
};
---

<section id="top" class="bg-paper text-ink">
  <div class="container-default grid items-center gap-12 pt-32 pb-20 md:pt-40 lg:grid-cols-[3fr_2fr] lg:gap-16">
    <div>
      <h1 class="max-w-3xl text-4xl tracking-tight text-brand md:text-5xl">
        <span class="text-neutral-500">Hey! I&rsquo;m Shaun. I</span> create <span class="text-neutral-500">and</span> optimise digital content <span class="text-neutral-500">to create better experiences.</span>
      </h1>

      <!-- Dividers only from tablet up, so a wrapped line on phones never starts with one -->
      <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-neutral-600 sm:gap-x-0">
        {roles.map((role, i) => (
          <li class:list={["sm:pr-3", i > 0 && "sm:border-l sm:border-neutral-300 sm:pl-3"]}>{role}</li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href="#contact"
          class="interactive inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3 text-ink hover:bg-brand/85 active:bg-brand/70"
        >
          Get in touch
          <Icon name="arrow-right" class="size-5" />
        </a>
        <a href="#experience" class="interactive underline underline-offset-4 hover:decoration-brand active:text-neutral-600">
          See my experience
        </a>
      </div>
    </div>

    <!-- ID card: a tilted badge with an orange card behind it for depth. It straightens on hover.
         Only shown on wide screens, where it sits beside the headline; on smaller screens it
         would push everything else down. The photo is a placeholder until the real one is ready. -->
    <div class="group relative hidden w-full max-w-sm justify-self-end lg:block">
      <div aria-hidden="true" class="absolute inset-0 translate-x-3 translate-y-2 rotate-3 rounded-2xl bg-brand"></div>

      <aside class="relative -rotate-2 overflow-hidden rounded-2xl bg-paper-raised shadow-xl shadow-ink/10 transition-transform duration-200 ease-out group-hover:rotate-0">
        <!-- Header band with the lanyard slot -->
        <div aria-hidden="true" class="flex justify-center bg-ink pt-3 pb-4">
          <span class="h-2 w-12 rounded-full bg-paper/25"></span>
        </div>

        <div class="p-6">
          <div class="flex items-center gap-4">
            <div class="flex size-20 shrink-0 items-center justify-center rounded-lg border border-dashed border-neutral-400 text-xs text-neutral-600">
              Photo
            </div>
            <div>
              <p class="text-2xl tracking-tight">Shaun</p>
              <p class="text-sm text-neutral-600">Digital Optimisation Executive</p>
            </div>
          </div>

          <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 border-t border-ink/10 pt-6">
            <div>
              <dt class="text-xs tracking-wide text-neutral-600 uppercase">Based in</dt>
              <dd class="mt-1">Kent, UK</dd>
            </div>
            <div>
              <dt class="text-xs tracking-wide text-neutral-600 uppercase">In digital since</dt>
              <dd class="mt-1 tabular-nums">2015</dd>
            </div>
            <div class="col-span-2">
              <dt class="text-xs tracking-wide text-neutral-600 uppercase">Working on</dt>
              <dd class="mt-1">Testing and content at Brakes / Sysco</dd>
            </div>

            {lastWatched && (
              <div class="col-span-2">
                <dt class="text-xs tracking-wide text-neutral-600 uppercase">Last watched</dt>
                <dd class="mt-2">
                  <a href={lastWatched.url} class="flex items-center gap-3 [&:hover_.film-title]:underline">
                    {lastWatched.poster && (
                      <img
                        src={posterAt(lastWatched.poster, 150)}
                        width="40"
                        height="60"
                        alt=""
                        class="h-15 w-10 shrink-0 rounded object-cover"
                      />
                    )}
                    <span>
                      <span class="film-title block underline-offset-4 decoration-brand">
                        {lastWatched.title} <span class="text-neutral-600 tabular-nums">({lastWatched.year})</span>
                      </span>
                      <span class="block text-sm text-neutral-600 tabular-nums">
                        {shortDate(lastWatched.watched)}{lastWatched.rewatch && ", rewatch"}
                      </span>
                    </span>
                  </a>
                </dd>
              </div>
            )}
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>
