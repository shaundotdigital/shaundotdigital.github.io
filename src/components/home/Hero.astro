---
import Icon from "../Icon.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getLetterboxd, posterAt } from "../../lib/letterboxd";
import hero from "../../data/hero.json";

// The words live in src/data/hero.json, which Pages CMS edits.
const { roles, card } = hero;

// Keep "I" on the same line as the word after it, so it is never left at the end of a line.
const headlineStart = hero.headlineStart.replace(/\bI /g, "I\u00a0");

// The ID card photo is picked in Pages CMS from src/assets, so Astro can still resize it.
const photos = import.meta.glob<{ default: ImageMetadata }>("/src/assets/*.{jpeg,jpg,png,webp,avif}", { eager: true });
const photo = photos[card.photo]?.default;
if (!photo) throw new Error(`Hero photo not found: ${card.photo}. It must be an image in src/assets.`);

// The "now" card uses the latest film from the same Letterboxd data as the films section.
const { recent } = await getLetterboxd();
const lastWatched = recent[0];

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const shortDate = (iso: string) => {
  const [, month, day] = iso.split("-").map(Number);
  return `${day} ${months[month - 1]}`;
};
---

<section id="top" class="texture-grid bg-paper text-ink">
  <div class="container-default grid items-center gap-12 pt-32 pb-20 md:pt-40 lg:grid-cols-[3fr_2fr] lg:gap-16">
    <div>
      <div class="flex flex-col items-start gap-4 min-[360px]:flex-row min-[360px]:items-center">
        <!-- Below wide screens the ID card is hidden, so the photo sits here instead -->
        <Image
          src={photo}
          alt={card.photoAlt}
          width={160}
          height={160}
          loading="eager"
          class="size-18 shrink-0 rounded-lg object-cover lg:hidden"
        />
        <!-- What I do, led by the brand dot. Slashes only from tablet up, so a wrapped line never starts with one. -->
        <div class="flex items-center gap-3">
          <span aria-hidden="true" class="size-3 shrink-0 rounded-full bg-brand"></span>
          <ul class="label flex flex-wrap gap-x-3 gap-y-1 text-neutral-600">
            {roles.map((role, i) => (
              <li class:list={[i > 0 && "sm:before:mr-3 sm:before:text-neutral-400 sm:before:content-['/']"]}>{role}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- The key phrase gets a black pill, like the logo, that sweeps in once the page loads.
           See .pill-reveal in global.css. It never wraps, so keep the phrase short. -->
      <h1 class="mt-6 max-w-3xl text-[2rem] leading-[1.2] sm:text-5xl xl:text-5xl">
        {headlineStart}{" "}
        <span class="relative inline-block rounded-full px-[0.4em] pt-[0.02em] pb-[0.1em] whitespace-nowrap">
          {hero.headlineHighlight}
          <!-- The same words on the black pill, revealed over the plain ones. The words come from
               data-label via CSS, so search engines and copy and paste only see them once. -->
          <span aria-hidden="true" data-label={hero.headlineHighlight} class="pill-reveal absolute inset-0 rounded-full bg-ink px-[0.4em] pt-[0.02em] pb-[0.1em] text-paper"></span>
        </span>{" "}
        {hero.headlineEnd}
      </h1>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href="#contact"
          class="button-primary"
        >
          {hero.primaryButton}
          <span class="button-dot"><Icon name="arrow-right" class="size-5" /></span>
        </a>
        <a href="#experience" class="link tap-target active:text-neutral-600">
          {hero.secondaryLink}
        </a>
      </div>
    </div>

    <!-- ID card: a tilted badge. It straightens on hover.
         Only shown on wide screens, where it sits beside the headline; on smaller screens it
         would push everything else down, so only the photo shows, above the headline. -->
    <div class="group relative hidden w-full max-w-sm justify-self-end lg:block">
      <aside class="relative -rotate-2 overflow-hidden rounded-2xl bg-paper-raised shadow-xl shadow-ink/10 transition-transform duration-200 ease-out group-hover:rotate-0">
        <!-- Header band with the lanyard slot -->
        <div aria-hidden="true" class="flex justify-center bg-ink pt-3 pb-4">
          <span class="h-2 w-12 rounded-full bg-paper/25"></span>
        </div>

        <div class="p-6">
          <div class="flex items-center gap-4">
            <!-- Astro resizes and compresses this at build time; 160px covers high-res screens -->
            <Image
              src={photo}
              alt={card.photoAlt}
              width={160}
              height={160}
              class="size-20 shrink-0 rounded-lg object-cover"
            />
            <div>
              <p class="font-display text-2xl font-bold">{card.name}</p>
              <p class="text-sm text-neutral-600">{card.jobTitle}</p>
            </div>
          </div>

          <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 border-t border-ink/10 pt-6">
            <div>
              <dt class="label text-neutral-600">Based in</dt>
              <dd class="mt-1">{card.basedIn}</dd>
            </div>
            <div>
              <dt class="label text-neutral-600">In digital since</dt>
              <dd class="mt-1 tabular-nums">{card.digitalSince}</dd>
            </div>
            <div class="col-span-2">
              <dt class="label text-neutral-600">Working on</dt>
              <dd class="mt-1">{card.workingOn}</dd>
            </div>

            {lastWatched && (
              <div class="col-span-2">
                <dt class="label text-neutral-600">Last watched</dt>
                <dd class="mt-2">
                  <a href={lastWatched.url} target="_blank" rel="noopener" class="flex items-center gap-3 [&:hover_.film-title]:underline">
                    {lastWatched.poster && (
                      <img
                        src={posterAt(lastWatched.poster, 70)}
                        srcset={`${posterAt(lastWatched.poster, 70)} 1x, ${posterAt(lastWatched.poster, 140)} 2x`}
                        width="40"
                        height="60"
                        alt=""
                        class="h-15 w-10 shrink-0 rounded-lg object-cover"
                      />
                    )}
                    <span>
                      <span class="film-title block underline-offset-4 decoration-brand">
                        {lastWatched.title} <span class="text-neutral-600 tabular-nums">({lastWatched.year})</span>
                      </span>
                      <span class="block text-sm text-neutral-600 tabular-nums">
                        {shortDate(lastWatched.watched)}{lastWatched.rewatch && ", rewatch"}
                      </span>
                    </span>
                  </a>
                </dd>
              </div>
            )}
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>
