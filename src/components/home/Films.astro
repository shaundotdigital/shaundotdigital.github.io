---
import Icon from "../Icon.astro";
import { getLetterboxd, posterAt } from "../../lib/letterboxd";

// Recently watched is fetched from Letterboxd at build time, favourites come from
// a data file. See src/lib/letterboxd.ts.
const { favourites, recent, filmsLogged, profileUrl } = await getLetterboxd();

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const shortDate = (iso: string) => {
  const [, month, day] = iso.split("-").map(Number);
  return `${day} ${months[month - 1]}`;
};
---

{(favourites.length > 0 || recent.length > 0) && (
  <section id="films" class="bg-paper-raised text-ink">
    <div class="container-default py-20">
      <h2 class="max-w-lg text-2xl leading-[1.2] md:text-3xl">
        Away from work I watch a lot of films{filmsLogged ? <span class="tabular-nums">, {filmsLogged} logged on Letterboxd so far.</span> : "."}
      </h2>

      <!-- Wide screens: favourites in one row of four on the left, recently watched 4x2 on the right.
           The 2:1 split keeps both blocks about the same height and the section short enough
           to fit on a laptop screen, with favourites larger. -->
      <div class="mt-10 grid gap-16 lg:grid-cols-[2fr_1fr] lg:gap-12">
      {favourites.length > 0 && (
        <div>
          <h3 class="label flex items-center gap-3 text-neutral-600">
            <span aria-hidden="true" class="size-3 shrink-0 rounded-full bg-brand"></span>
            Four favourites
          </h3>
          <ol class="mt-4 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4 md:gap-x-6 lg:gap-x-4">
            {favourites.map((film) => (
              <li>
                <a href={film.url} class="group block">
                  <div class="flex aspect-[2/3] items-center justify-center overflow-hidden rounded-lg bg-neutral-200 transition-transform duration-150 ease-out group-hover:-translate-y-1 group-active:translate-y-0">
                    {film.poster ? (
                      <img
                        src={posterAt(film.poster, 230)}
                        srcset={`${posterAt(film.poster, 150)} 150w, ${posterAt(film.poster, 230)} 230w, ${posterAt(film.poster, 300)} 300w`}
                        sizes="(min-width: 1200px) 170px, (min-width: 1024px) calc(16.6vw - 31px), (min-width: 768px) calc(25vw - 34px), calc(50vw - 40px)"
                        width="300"
                        height="450"
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="size-full object-cover"
                      />
                    ) : (
                      <span class="p-4 text-center text-sm text-neutral-600">No poster</span>
                    )}
                  </div>
                  <p class="mt-3 underline-offset-4 group-hover:underline group-hover:decoration-brand">{film.title}</p>
                  <p class="text-sm text-neutral-600 tabular-nums">
                    {[film.year, film.director].filter(Boolean).join(" · ")}
                  </p>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}

      {recent.length > 0 && (
        <div>
          <h3 class="label flex items-center gap-3 text-neutral-600">
            <span aria-hidden="true" class="size-3 shrink-0 rounded-full bg-brand"></span>
            Recently watched
          </h3>
          <!-- Always whole rows: 4 across on phones (8 films), 5 across on tablets (10), 4 across beside the favourites (8) -->
          <ol class="mt-4 grid grid-cols-4 gap-x-3 gap-y-6 sm:grid-cols-5 md:gap-x-6 lg:grid-cols-4 lg:gap-x-3">
            {recent.map((film) => (
              <li class="max-sm:[&:nth-child(n+9)]:hidden sm:max-lg:[&:nth-child(n+11)]:hidden lg:[&:nth-child(n+9)]:hidden">
                <a href={film.url} class="group block">
                  <div class="flex aspect-[2/3] items-center justify-center overflow-hidden rounded-lg bg-neutral-200 transition-transform duration-150 ease-out group-hover:-translate-y-1 group-active:translate-y-0">
                    {film.poster ? (
                      <img
                        src={posterAt(film.poster, 140)}
                        srcset={`${posterAt(film.poster, 70)} 70w, ${posterAt(film.poster, 140)} 140w, ${posterAt(film.poster, 230)} 230w`}
                        sizes="(min-width: 1200px) 82px, (min-width: 1024px) calc(8.3vw - 18px), (min-width: 768px) calc(20vw - 32px), (min-width: 640px) calc(20vw - 22px), calc(25vw - 25px)"
                        width="150"
                        height="225"
                        alt={`${film.title} (${film.year})`}
                        loading="lazy"
                        decoding="async"
                        class="size-full object-cover"
                      />
                    ) : (
                      <span class="p-2 text-center text-xs text-neutral-600">{film.title}</span>
                    )}
                  </div>
                  <p class="mt-2 flex flex-wrap items-center gap-x-1.5 text-xs text-neutral-600 tabular-nums">
                    {shortDate(film.watched)}
                    {film.rewatch && (
                      <>
                        <Icon name="repeat" class="size-3.5" />
                        <span class="sr-only">Rewatch</span>
                      </>
                    )}
                    {film.liked && (
                      <>
                        <Icon name="heart" class="size-3.5" />
                        <span class="sr-only">Liked</span>
                      </>
                    )}
                  </p>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}
      </div>

      <p class="mt-8 text-sm">
        <a href={profileUrl} class="link active:text-neutral-600">
          My full diary on Letterboxd <Icon name="arrow-up-right" class="inline size-4 -translate-y-0.5" />
        </a>
      </p>
    </div>
  </section>
)}
