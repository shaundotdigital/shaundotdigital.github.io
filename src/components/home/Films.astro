---
import Icon from "../Icon.astro";
import { getLetterboxd, posterAt } from "../../lib/letterboxd";

// Recently watched is fetched from Letterboxd at build time, favourites come from
// a data file. See src/lib/letterboxd.ts.
const { favourites, recent, filmsLogged, profileUrl } = await getLetterboxd();

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const shortDate = (iso: string) => {
  const [, month, day] = iso.split("-").map(Number);
  return `${day} ${months[month - 1]}`;
};
---

{(favourites.length > 0 || recent.length > 0) && (
  <section id="films" class="bg-paper-raised text-ink">
    <div class="container-default py-20">
      <h2 class="max-w-md text-2xl tracking-tight md:text-3xl">
        <span class="text-neutral-500">Away from work</span> I watch a lot of films{filmsLogged ? (
          <>
            ,{" "}
            <span class="text-neutral-500 tabular-nums">{filmsLogged} logged on Letterboxd so far.</span>
          </>
        ) : "."}
      </h2>

      {favourites.length > 0 && (
        <>
          <h3 class="mt-10 text-xs tracking-wide text-neutral-600 uppercase">Four favourites</h3>
          <ol class="mt-4 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4 md:gap-x-6">
            {favourites.map((film) => (
              <li>
                <a href={film.url} class="group block">
                  <div class="flex aspect-[2/3] items-center justify-center overflow-hidden rounded-lg bg-neutral-200 transition-transform duration-150 ease-out group-hover:-translate-y-1 group-active:translate-y-0">
                    {film.poster ? (
                      <img
                        src={posterAt(film.poster, 300)}
                        srcset={`${posterAt(film.poster, 300)} 300w, ${posterAt(film.poster, 600)} 600w`}
                        sizes="(min-width: 768px) 25vw, 50vw"
                        width="300"
                        height="450"
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="size-full object-cover"
                      />
                    ) : (
                      <span class="p-4 text-center text-sm text-neutral-600">No poster</span>
                    )}
                  </div>
                  <p class="mt-3 text-lg underline-offset-4 group-hover:underline group-hover:decoration-brand">{film.title}</p>
                  <p class="text-sm text-neutral-600 tabular-nums">
                    {[film.year, film.director].filter(Boolean).join(" · ")}
                  </p>
                </a>
              </li>
            ))}
          </ol>
        </>
      )}

      {recent.length > 0 && (
        <>
          <h3 class="mt-16 text-xs tracking-wide text-neutral-600 uppercase">Recently watched</h3>
          <!-- Bleeds to the screen edge so the row can scroll sideways on small screens -->
          <ol class="-mx-8 mt-4 flex snap-x scroll-px-8 gap-3 overflow-x-auto px-8 pt-1 pb-2">
            {recent.map((film) => (
              <li class="w-28 shrink-0 snap-start">
                <a href={film.url} class="group block">
                  <div class="flex aspect-[2/3] items-center justify-center overflow-hidden rounded-lg bg-neutral-200 transition-transform duration-150 ease-out group-hover:-translate-y-1 group-active:translate-y-0">
                    {film.poster ? (
                      <img
                        src={posterAt(film.poster, 150)}
                        srcset={`${posterAt(film.poster, 150)} 1x, ${posterAt(film.poster, 300)} 2x`}
                        width="150"
                        height="225"
                        alt={`${film.title} (${film.year})`}
                        loading="lazy"
                        decoding="async"
                        class="size-full object-cover"
                      />
                    ) : (
                      <span class="p-2 text-center text-xs text-neutral-600">{film.title}</span>
                    )}
                  </div>
                  <p class="mt-2 flex items-center gap-1.5 text-xs text-neutral-600 tabular-nums">
                    {shortDate(film.watched)}
                    {film.rewatch && (
                      <>
                        <Icon name="repeat" class="size-3.5" />
                        <span class="sr-only">Rewatch</span>
                      </>
                    )}
                    {film.liked && (
                      <>
                        <Icon name="heart" class="size-3.5" />
                        <span class="sr-only">Liked</span>
                      </>
                    )}
                  </p>
                </a>
              </li>
            ))}
          </ol>
        </>
      )}

      <p class="mt-8 text-sm">
        <a href={profileUrl} class="interactive underline underline-offset-4 hover:decoration-brand active:text-neutral-600">
          My full diary on Letterboxd <Icon name="arrow-up-right" class="inline size-4 -translate-y-0.5" />
        </a>
      </p>
    </div>
  </section>
)}
