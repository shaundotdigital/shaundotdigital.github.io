---
// Work history, newest first, drawn as one timeline. The current role is first and
// gets the orange marker. `earlier` lists previous titles at the same company.
interface Role {
  title: string;
  dates: string;
}

interface Entry {
  dates: string;
  title: string;
  company: string;
  current?: boolean;
  earlier?: Role[];
  summary: string;
  tags?: string[];
}

const entries: Entry[] = [
  {
    dates: "Oct 2023 - Present",
    title: "Digital Optimisation Executive",
    company: "Brakes / Sysco",
    current: true,
    summary:
      "Part of the Brand and Digital Optimisation team. I run A/B and multivariate tests in Salesforce Personalisation, build pages and reusable components in Amplience, manage categories and products in SAP, and report on performance to shape content, UX and trading decisions.",
    tags: ["A/B testing", "Analytics", "CRO", "UX", "SEO", "Amplience", "SAP", "Salesforce"],
  },
  {
    dates: "Jan 2021 - Oct 2023",
    title: "Lead Senior Designer",
    company: "hellooodesign",
    summary:
      "Joined a new design agency at launch and looked after its brand guidelines and design system. Led WordPress builds from design to launch, with over 35 sites designed, including busy e-commerce stores, plus email campaigns and print work such as brochures and business cards.",
    tags: ["Web design", "WordPress", "Brand guidelines", "Print", "Photoshop", "Illustrator", "Google Analytics"],
  },
  {
    dates: "Jan 2020 - Dec 2020",
    title: "Senior Web Designer",
    company: "Smart DesignUK",
    summary:
      "Worked with the sales team and clients to take responsive websites from first brief to handover. Ran planning meetings, presented designs, briefed freelancers and set up domains and hosting.",
    tags: ["Web design", "Photoshop", "Illustrator"],
  },
  {
    dates: "Jul 2015 - Jul 2019",
    title: "Web Manager",
    company: "TRI UK",
    earlier: [{ title: "Digital Content Developer, contract", dates: "Jul 2015 - May 2016" }],
    summary:
      "Started on contract making newsletters, store graphics and the 2016 catalogue, then came back as Web Manager to lead the move of TRI UK's website and IT systems into the Sports Direct group. That meant modernising the e-commerce site and payment gateway, managing data for thousands of products, designing for print and online, setting up IT for three stores and working with over twenty cycling brands on their London Bike Show stands.",
    tags: ["E-commerce", "SEO", "Product data", "Adobe Creative Suite", "Mailchimp", "IT support"],
  },
];
---

<section id="experience" class="bg-paper text-ink">
  <div class="container-default py-20">
    <h2 class="max-w-md text-2xl tracking-tight md:text-3xl">
      <span class="text-neutral-500">I currently</span> work at Brakes / Sysco,{" "}
      <span class="text-neutral-500">improving the</span> online customer experience.
    </h2>

    <ol class="mt-12">
      {entries.map((entry, i) => (
        <li class="grid gap-1 md:grid-cols-[11rem_1fr] md:gap-6">
          <p class="text-xs tracking-wide text-neutral-600 uppercase tabular-nums md:pt-1.5">{entry.dates}</p>

          <!-- The left border is the timeline rail. Padding, not margins, keeps it unbroken between entries. -->
          <div class:list={["relative md:border-l md:border-ink/10 md:pl-8", i < entries.length - 1 && "pb-12"]}>
            <span
              aria-hidden="true"
              class:list={[
                "absolute top-2 -left-[5px] hidden size-2.5 rounded-full md:block",
                entry.current ? "bg-brand" : "bg-neutral-300",
              ]}
            ></span>

            <h3 class:list={[entry.current ? "text-xl" : "text-lg"]}>
              {entry.title} <span class="text-neutral-500">&middot; {entry.company}</span>
            </h3>

            {entry.earlier && (
              <ul class="mt-1 text-sm text-neutral-600">
                {entry.earlier.map((role) => (
                  <li>
                    Before that: {role.title}, <span class="tabular-nums">{role.dates}</span>
                  </li>
                ))}
              </ul>
            )}

            <p class="mt-2 max-w-xl text-sm leading-relaxed text-neutral-600">{entry.summary}</p>

            {entry.tags && (
              <ul class="mt-4 flex max-w-xl flex-wrap gap-2">
                {entry.tags.map((tag) => (
                  <li class="rounded-full bg-ink/5 px-3 py-1 text-xs text-neutral-700">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
