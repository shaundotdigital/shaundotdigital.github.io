---
// Work history, newest first, drawn as one timeline. The current role is first and
// gets the orange marker. A company with more than one role lists them under the
// company name, newest first, each with its own dates.
// The entries live in src/data/experience.json, which Pages CMS edits.
import experience from "../../data/experience.json";

interface Role {
  title: string;
  dates: string;
  summary: string;
  tags: string[];
}

interface Entry {
  company: string;
  dates: string;
  /** Shown under a multi-role company name, e.g. what the company is called now. */
  note: string;
  current: boolean;
  roles: Role[];
}

const entries: Entry[] = experience.entries;
---

<section id="experience" class="theme-inverse bg-ink text-paper">
  <div class="container-default py-20">
    <h2 class="max-w-lg text-2xl leading-[1.2] md:text-3xl">
      {experience.heading}
    </h2>

    <ol class="mt-12">
      {entries.map((entry, i) => (
        <li class="grid gap-1 md:grid-cols-[11rem_1fr] md:gap-6">
          <p class="label text-brand tabular-nums md:pt-1">{entry.dates}</p>

          <!-- The left border is the timeline rail. Padding, not margins, keeps it unbroken between entries. -->
          <div class:list={["relative md:border-l md:border-paper/15 md:pl-8", i < entries.length - 1 && "pb-12"]}>
            <span
              aria-hidden="true"
              class:list={[
                "absolute top-2 -left-[5px] hidden size-2.5 rounded-full md:block",
                entry.current ? "bg-brand" : "bg-paper/35",
              ]}
            ></span>

            {entry.roles.length === 1 ? (
              <>
                <h3 class:list={[entry.current ? "text-xl" : "text-lg"]}>
                  {entry.roles[0].title} <span class="text-paper/60">&middot; {entry.company}</span>
                </h3>
                {entry.note && <p class="text-sm text-paper/70">{entry.note}</p>}
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-paper/70">{entry.roles[0].summary}</p>
                {entry.roles[0].tags.length > 0 && (
                  <ul class="mt-4 flex max-w-xl flex-wrap gap-2">
                    {entry.roles[0].tags.map((tag) => (
                      <li class="rounded-full bg-paper/10 px-3 py-1 text-xs text-paper/85">{tag}</li>
                    ))}
                  </ul>
                )}
              </>
            ) : (
              <>
                <h3 class="text-lg">{entry.company}</h3>
                <p class="text-sm text-paper/70">{[entry.note, `${entry.roles.length} roles`].filter(Boolean).join(" · ")}</p>

                <!-- Roles at the same company, newest first. Small hollow markers sit on the main rail. -->
                <ol class="mt-6 space-y-8">
                  {entry.roles.map((role) => (
                    <li class="relative">
                      <span
                        aria-hidden="true"
                        class="absolute top-1.5 -left-[36px] hidden size-2 rounded-full border border-paper/50 bg-ink md:block"
                      ></span>
                      <h4 class="flex flex-wrap items-baseline gap-x-3">
                        <span>{role.title}</span>
                        <span class="text-sm text-paper/70 tabular-nums">{role.dates}</span>
                      </h4>
                      <p class="mt-2 max-w-xl text-sm leading-relaxed text-paper/70">{role.summary}</p>
                      {role.tags.length > 0 && (
                        <ul class="mt-4 flex max-w-xl flex-wrap gap-2">
                          {role.tags.map((tag) => (
                            <li class="rounded-full bg-paper/10 px-3 py-1 text-xs text-paper/85">{tag}</li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ol>
              </>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
