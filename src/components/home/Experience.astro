---
import Icon from "../Icon.astro";

// Placeholder timeline of earlier roles. Newest first. The current role lives in
// FeaturedRole.astro, so it is not repeated here. `roles` lists earlier titles at the same company,
// `links` and `tags` are optional.
interface Entry {
  dates: string;
  title: string;
  company: string;
  href?: string;
  roles?: string[];
  summary: string;
  links?: { label: string; href: string }[];
  tags?: string[];
}

const entries: Entry[] = [
  {
    dates: "20XX - 2023",
    title: "Job title",
    company: "Company",
    href: "#",
    roles: ["Earlier title", "First title"],
    summary:
      "Placeholder summary. Use this entry for a longer stint with more than one title, listing the earlier ones under the main heading.",
    tags: ["Skill", "Skill", "Skill", "Skill", "Skill", "Skill"],
  },
  {
    dates: "20XX - 20XX",
    title: "Job title",
    company: "Company",
    href: "#",
    summary:
      "Placeholder summary. Use this entry for a shorter role or project, with links out to related work or coverage.",
    links: [
      { label: "Link one", href: "#" },
      { label: "Link two", href: "#" },
    ],
    tags: ["Skill", "Skill", "Skill"],
  },
];
---

<section id="experience" class="bg-paper text-ink">
  <div class="container-default py-20">
    <h2 class="sr-only">Earlier experience</h2>

    <ol class="space-y-10">
      {entries.map((entry) => (
        <li class="grid gap-2 md:grid-cols-[11rem_1fr] md:gap-6">
          <p class="pt-1 text-xs tracking-wide text-neutral-600 uppercase tabular-nums">{entry.dates}</p>

          <div>
            <h3 class="text-lg">
              {entry.href ? (
                <a href={entry.href} class="interactive underline-offset-4 hover:underline hover:decoration-brand active:text-neutral-600">
                  {entry.title} &middot; {entry.company} <Icon name="arrow-up-right" class="inline size-4 -translate-y-0.5" />
                </a>
              ) : (
                <>{entry.title} &middot; {entry.company}</>
              )}
            </h3>

            {entry.roles && (
              <ul class="text-neutral-600">
                {entry.roles.map((role) => <li>{role}</li>)}
              </ul>
            )}

            <p class="mt-2 max-w-xl text-sm leading-relaxed text-neutral-600">{entry.summary}</p>

            {entry.links && (
              <ul class="mt-4 flex flex-wrap gap-4 text-sm">
                {entry.links.map((link) => (
                  <li><a href={link.href} class="interactive underline underline-offset-4 hover:decoration-brand active:text-neutral-600">{link.label}</a></li>
                ))}
              </ul>
            )}

            {entry.tags && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {entry.tags.map((tag) => (
                  <li class="rounded-full bg-ink/5 px-3 py-1 text-xs text-neutral-700">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
