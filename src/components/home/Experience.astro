---
import Icon from "../Icon.astro";

// Earlier roles, newest first. The current role lives in
// FeaturedRole.astro, so it is not repeated here. `roles` lists earlier titles at the same company,
// `links` and `tags` are optional.
interface Entry {
  dates: string;
  title: string;
  company: string;
  href?: string;
  roles?: string[];
  summary: string;
  links?: { label: string; href: string }[];
  tags?: string[];
}

const entries: Entry[] = [
  {
    dates: "Jan 2021 - Oct 2023",
    title: "Lead Senior Designer",
    company: "hellooodesign",
    summary:
      "Joined a new design agency at launch and looked after its brand guidelines and design system. Led WordPress builds from design to launch, with over 35 sites designed, including busy e-commerce stores, plus email campaigns and print work such as brochures and business cards.",
    tags: ["Web design", "WordPress", "Brand guidelines", "Print", "Photoshop", "Illustrator", "Google Analytics"],
  },
  {
    dates: "Jan 2020 - Dec 2020",
    title: "Senior Web Designer",
    company: "Smart DesignUK",
    summary:
      "Worked with the sales team and clients to take responsive websites from first brief to handover. Ran planning meetings, presented designs, briefed freelancers and set up domains and hosting.",
    tags: ["Web design", "Photoshop", "Illustrator"],
  },
  {
    dates: "Aug 2019 - Sep 2019",
    title: "Website Content Administrator",
    company: "ZLT Electrical",
    summary:
      "Kept pricing, specs and images accurate across a catalogue of over 65,000 products. Added products through the ERP system and uploaded them to three websites in bulk with CSV files.",
    tags: ["Product data", "Excel", "Web analytics"],
  },
  {
    dates: "Aug 2017 - Jul 2019",
    title: "Web Manager",
    company: "TRI UK",
    summary:
      "Led the move of TRI UK's website and IT systems into the Sports Direct group, modernising the e-commerce site and its payment gateway. Managed product data for thousands of products, designed online and print media, set up IT for three stores and worked with over twenty cycling brands on their London Bike Show stands.",
    tags: ["E-commerce", "SEO", "Product data", "phpMyAdmin", "Adobe Creative Suite", "IT support"],
  },
  {
    dates: "Jul 2015 - May 2016",
    title: "Digital Content Developer",
    company: "TRI UK",
    summary:
      "Contract role making weekly Mailchimp newsletters for three stores and graphics for the website, social media and in-store use. Also ran the 2016 TRI UK catalogue, keeping suppliers and deadlines on track.",
    tags: ["Photoshop", "Illustrator", "InDesign", "Mailchimp", "Social media"],
  },
];
---

<section id="experience" class="bg-paper text-ink">
  <div class="container-default py-20">
    <h2 class="sr-only">Earlier experience</h2>

    <ol class="space-y-10">
      {entries.map((entry) => (
        <li class="grid gap-2 md:grid-cols-[11rem_1fr] md:gap-6">
          <p class="pt-1 text-xs tracking-wide text-neutral-600 uppercase tabular-nums">{entry.dates}</p>

          <div>
            <h3 class="text-lg">
              {entry.href ? (
                <a href={entry.href} class="interactive underline-offset-4 hover:underline hover:decoration-brand active:text-neutral-600">
                  {entry.title} &middot; {entry.company} <Icon name="arrow-up-right" class="inline size-4 -translate-y-0.5" />
                </a>
              ) : (
                <>{entry.title} &middot; {entry.company}</>
              )}
            </h3>

            {entry.roles && (
              <ul class="text-neutral-600">
                {entry.roles.map((role) => <li>{role}</li>)}
              </ul>
            )}

            <p class="mt-2 max-w-xl text-sm leading-relaxed text-neutral-600">{entry.summary}</p>

            {entry.links && (
              <ul class="mt-4 flex flex-wrap gap-4 text-sm">
                {entry.links.map((link) => (
                  <li><a href={link.href} class="interactive underline underline-offset-4 hover:decoration-brand active:text-neutral-600">{link.label}</a></li>
                ))}
              </ul>
            )}

            {entry.tags && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {entry.tags.map((tag) => (
                  <li class="rounded-full bg-ink/5 px-3 py-1 text-xs text-neutral-700">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
