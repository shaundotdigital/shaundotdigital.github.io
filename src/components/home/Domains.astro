---
// Placeholder cards. Six short statements about the areas you have worked in.
const cards = [
  "Website performance and conversion work for a large B2B e‑commerce site.",
  "A/B and multivariate testing, from hypothesis through to rollout.",
  "Analytics and reporting that shape UX and content decisions.",
  "Content and campaign management across CMS and commerce platforms.",
  "Working with SEO, e‑commerce and brand teams on shared goals.",
  "Design for print and brand consistency across channels.",
];
---

<section id="domains" class="bg-paper text-ink">
  <div class="container-default py-20">
    <h2 class="max-w-md text-2xl tracking-tight md:text-3xl">
      <span class="text-neutral-500">I&rsquo;ve worked with</span> digital across various teams{" "}
      <span class="text-neutral-500">and disciplines.</span>
    </h2>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card) => (
        <li class="min-h-36 rounded-2xl bg-paper-raised p-6 text-neutral-700">{card}</li>
      ))}
    </ul>
  </div>
</section>
