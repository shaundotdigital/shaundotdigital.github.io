---
// Approach: how I work. Four short cards, one idea each.
// The words live in src/data/approach.json, which Pages CMS edits.
import approach from "../../data/approach.json";
---

<section id="domains" class="bg-paper-raised text-ink">
  <div class="container-default pt-12 pb-20">
    <h2 class="max-w-2xl text-2xl leading-[1.2] md:text-3xl">
      {approach.heading}
    </h2>
    <p class="mt-4 max-w-2xl text-lg text-neutral-700">
      {approach.intro}
    </p>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {approach.cards.map((card) => (
        <li class="rounded-2xl bg-paper p-6">
          <h3 class="text-lg">{card.title}</h3>
          <p class="mt-2 text-neutral-700">{card.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
