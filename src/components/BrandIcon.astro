export type Brand = keyof typeof icons;

interface Props {
  name: Brand;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;
const icon = icons[name];
---

<svg aria-hidden="true" viewBox={icon.viewBox} class={className} fill="currentColor">
  <path d={icon.path} />
</svg>
