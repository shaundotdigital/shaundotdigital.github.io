---
import Logo from "./Logo.astro";
import site from "../data/site.json";
import ThemeToggle from "./ThemeToggle.astro";
import { getProjects } from "../lib/projects";

// One link per section on the homepage, in page order. Links start with "/" so they
// also work from other pages, such as /privacy. The labels live in src/data/site.json.
// An item with a path goes to that page instead. The Projects link only shows once there
// is a project to see: drafts count on the dev server, only published ones in the live build.
const hasProjects = (await getProjects()).length > 0;
const links = site.nav
  .filter((item) => !("path" in item) || item.path !== "/projects" || hasProjects)
  .map((item) => {
    const path = "path" in item ? item.path : undefined;
    return {
      label: item.label,
      href: path ?? `/#${item.section}`,
      current: path !== undefined && Astro.url.pathname.startsWith(path),
    };
  });
---

<header class="absolute inset-x-0 top-0 z-10">
  <div class="container-default relative flex items-center justify-between gap-x-6 py-5">
    <!-- The logo is the link home, so there is no separate Home item -->
    <a href="/" aria-label="Shaun, home" class="logo-link tap-target interactive rounded-full active:opacity-70">
      <Logo class="text-2xl" />
    </a>

    <!-- Right side: links (tablet and up), the light/dark switch, and the menu button (phones) -->
    <div class="flex items-center gap-2 sm:gap-4">
    <nav aria-label="Main" class="hidden items-center gap-1 text-sm sm:flex">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.current ? "page" : undefined}
          class:list={[
            "interactive rounded-full px-3 py-1.5 hover:bg-ink/5 hover:text-ink active:bg-ink/10",
            link.current ? "bg-ink/5 text-ink" : "text-neutral-600",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <ThemeToggle />

    <!-- Phones: a menu button in the style of the logo (outline pill, lowercase bold).
         It reads "menu" when closed and "close" when open, and fills black on hover. -->
    <button
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
      class="interactive relative inline-flex items-center rounded-full border-2 border-ink px-4 py-2 font-display text-base leading-none font-bold text-ink lowercase hover:bg-ink hover:text-paper active:opacity-80 after:absolute after:-inset-1.5 after:content-[''] sm:hidden"
    >
      <span class="pb-[0.08em]" data-menu-label>menu</span>
    </button>
    </div>

    <nav
      id="mobile-menu"
      aria-label="Main"
      hidden
      class="absolute inset-x-6 top-full rounded-2xl bg-paper-raised p-2 shadow-xl shadow-ink/10 sm:hidden"
    >
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.current ? "page" : undefined}
          class="interactive block rounded-lg px-4 py-3 font-display text-lg font-medium hover:bg-ink/5 active:bg-ink/10"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Header logo only: on hover or keyboard focus the dot clicks (presses in and bounces
     back). Logos elsewhere on the site don't have the logo-link wrapper, so they stay still.
     Skipped for reduced motion. The keyframes (logo-dot-click) are in global.css. */
  @media (prefers-reduced-motion: no-preference) {
    .logo-link:hover :global(.logo-dot),
    .logo-link:focus-visible :global(.logo-dot) {
      animation: logo-dot-click 450ms ease-out;
    }
  }
</style>

<script>
  // Opens and closes the phone menu. It closes when a link is chosen, on Escape,
  // or on a tap anywhere outside it.
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");

  if (button && menu) {
    const label = button.querySelector<HTMLElement>("[data-menu-label]");

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      if (label) label.textContent = open ? "close" : "menu";
    };

    button.addEventListener("click", () => setOpen(menu.hidden !== false));

    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        setOpen(false);
        button.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (!menu.hidden && !menu.contains(target) && !button.contains(target)) setOpen(false);
    });
  }
</script>
