---
import Icon from "./Icon.astro";

// Placeholder navigation. Swap the hrefs for real pages as they get built.
const links = [
  { label: "Home", href: "/", current: true },
  { label: "CV", href: "#experience" },
  { label: "Approach", href: "#domains" },
  { label: "Playbook", href: "#" },
  { label: "Contact", href: "#" },
];

const work = [
  { label: "Project one", href: "#" },
  { label: "Project two", href: "#" },
  { label: "Project three", href: "#" },
];
---

<header class="absolute inset-x-0 top-0 z-10">
  <nav aria-label="Main" class="flex flex-wrap items-center justify-center gap-1 p-4 text-sm">
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={link.current ? "page" : undefined}
        class:list={[
          "interactive rounded-full px-3 py-1.5 active:bg-white/20",
          link.current ? "bg-white/10 text-white" : "text-neutral-400 hover:text-white",
        ]}
      >
        {link.label}
      </a>
    ))}

    <details class="relative" data-nav-menu>
      <summary class="interactive flex cursor-pointer list-none items-center gap-1 rounded-full px-3 py-1.5 text-neutral-400 hover:text-white active:bg-white/20 [&::-webkit-details-marker]:hidden">
        Work <Icon name="chevron-down" class="size-4" />
      </summary>
      <ul class="absolute right-0 mt-2 w-44 rounded-lg border border-white/10 bg-ink p-2">
        {work.map((item) => (
          <li>
            <a href={item.href} class="interactive block px-3 py-1.5 text-neutral-400 hover:bg-white/10 hover:text-white active:bg-white/20">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>

<script>
  // Close the Work menu on Escape or a click outside it.
  const menu = document.querySelector<HTMLDetailsElement>("[data-nav-menu]");

  if (menu) {
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
