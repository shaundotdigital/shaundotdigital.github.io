---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

// Placeholder navigation. Swap the hrefs for real pages as they get built.
const links = [
  { label: "CV", href: "#experience" },
  { label: "Approach", href: "#domains" },
  { label: "Films", href: "#films" },
  { label: "Playbook", href: "#" },
  { label: "Contact", href: "#contact" },
];

const work = [
  { label: "Project one", href: "#" },
  { label: "Project two", href: "#" },
  { label: "Project three", href: "#" },
];
---

<header class="absolute inset-x-0 top-0 z-10">
  <div class="container-default flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-5">
  <!-- The logo is the link home, so there is no separate Home item -->
  <a href="/" aria-label="Shaun, home" class="interactive rounded-full hover:opacity-85 active:opacity-70">
    <Logo class="text-2xl" />
  </a>

  <nav aria-label="Main" class="-mx-3 flex flex-wrap items-center gap-1 text-sm">
    {links.map((link) => (
      <a
        href={link.href}
        class="interactive rounded-full px-3 py-1.5 text-neutral-600 hover:bg-ink/5 hover:text-ink active:bg-ink/10"
      >
        {link.label}
      </a>
    ))}

    <details class="relative" data-nav-menu>
      <summary class="interactive flex cursor-pointer list-none items-center gap-1 rounded-full px-3 py-1.5 text-neutral-600 hover:text-ink active:bg-ink/10 [&::-webkit-details-marker]:hidden">
        Work <Icon name="chevron-down" class="size-4" />
      </summary>
      <ul class="absolute right-0 mt-2 w-44 rounded-lg border border-ink/10 bg-paper-raised p-2">
        {work.map((item) => (
          <li>
            <a href={item.href} class="interactive block px-3 py-1.5 text-neutral-600 hover:bg-ink/5 hover:text-ink active:bg-ink/10">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
  </div>
</header>

<script>
  // Close the Work menu on Escape or a click outside it.
  const menu = document.querySelector<HTMLDetailsElement>("[data-nav-menu]");

  if (menu) {
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
