---
// A recreated tweet: the original text, time and counts. It looks the same in light and
// dark mode, like a screenshot would, so its colours are fixed instead of using the site's.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	author: string;
	handle: string;
	// The account's profile picture. Without one, the avatar letters are shown instead.
	avatarImage?: ImageMetadata;
	avatar: string;
	rank?: number;
	text: string;
	time: string;
	replies: number;
	reposts: number;
	likes: number;
	url?: string;
}

const { author, handle, avatarImage, avatar, rank, text, time, replies, reposts, likes, url } = Astro.props;

// Hashtags and @mentions are picked out in blue, like on Twitter.
const parts = text
	.split(/([@#][A-Za-z0-9_]+)/)
	.filter((part) => part !== "")
	.map((part) => ({ part, link: /^[@#]/.test(part) }));

const plural = (count: number, one: string, many: string) => (count === 1 ? one : many);
const counts = [
	{ n: replies, word: plural(replies, "reply", "replies"), path: ["M21 12a8 8 0 0 1-11.6 7.1L4 20l1.1-4.6A8 8 0 1 1 21 12z"] },
	{
		n: reposts,
		word: plural(reposts, "retweet", "retweets"),
		path: ["M7 4 3 8l4 4", "M3 8h13a4 4 0 0 1 4 4v1", "m17 20 4-4-4-4", "M21 16H8a4 4 0 0 1-4-4v-1"],
	},
	{ n: likes, word: plural(likes, "like", "likes"), path: ["M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"] },
];
---

<article class="flex h-full flex-col gap-3 rounded-2xl bg-white p-4 text-[#101010]">
	<header class="flex items-center gap-3">
		{avatarImage ? (
			<Image src={avatarImage} alt="" width={40} height={40} densities={[2]} class="size-10 flex-none rounded-full object-cover ring-1 ring-[#e2e2e2]" />
		) : avatar && (
			<span aria-hidden="true" class="flex size-10 flex-none items-center justify-center rounded-full bg-[#101010] text-xs font-bold text-[#f5f4f0]">
				{avatar}
			</span>
		)}
		<div class="flex min-w-0 flex-col leading-snug">
			<span class="font-bold">{author}</span>
			<span class="text-sm text-[#666666]">{handle}</span>
		</div>
		{rank && (
			<span class="ml-auto rounded-full bg-[#f5f4f0] px-3 py-1 text-sm font-bold tabular-nums" aria-label={`Rank ${rank}`}>
				#{rank}
			</span>
		)}
	</header>

	<p class="text-base leading-relaxed [overflow-wrap:anywhere] whitespace-pre-wrap text-pretty">
		{parts.map(({ part, link }) => (link ? <span class="text-[#1d6fb8]">{part}</span> : part))}
	</p>

	<p class="mt-auto text-sm text-[#666666]">{time}</p>

	<ul class="flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-[#e2e2e2] pt-3 text-sm text-[#666666] tabular-nums">
		{counts.map(({ n, word, path }) => (
			<li class="inline-flex items-center gap-1.5">
				<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					{path.map((d) => <path d={d} />)}
				</svg>
				<b class="text-[#101010]">{n}</b>{word}
			</li>
		))}
	</ul>

	<div class="flex flex-wrap justify-between gap-x-3 gap-y-1 text-xs text-[#666666]">
		<span>Recreated from Twitter</span>
		{url && (
			<a href={url} rel="noopener" class="text-[#101010] underline underline-offset-4">View on Twitter</a>
		)}
	</div>
</article>
