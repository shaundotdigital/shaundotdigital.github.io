---
// A column chart in a card. Two shapes:
//   periods: a few wide columns, each with its value on top and its label underneath.
//   months: many thin columns, with only the ticks (e.g. a year) labelled.
// Grey columns are the "before" period, brand colour is "after".
interface Bar {
	label: string;
	value: number;
	after: boolean;
	tick?: string;
}

interface Props {
	title: string;
	alt?: string;
	note?: string;
	bars: Bar[];
	periods: { before: string; after: string };
	variant: "periods" | "months";
	// The card sits on the opposite surface to its section, so it always stands out.
	surface: "raised" | "paper";
}

const { title, alt, note, bars, periods, variant, surface } = Astro.props;

const isPeriods = variant === "periods";
const plotHeight = isPeriods ? 200 : 230;
const max = Math.max(...bars.map((b) => b.value), 1);
const heightOf = (value: number) => Math.max(2, Math.round((value / max) * plotHeight));
const description = alt ?? `${title}. ${bars.map((b) => `${b.label}: ${b.value}`).join(", ")}.`;
---

<figure class:list={["flex flex-col gap-6 rounded-2xl p-6 sm:p-8", surface === "raised" ? "bg-paper-raised" : "bg-paper"]}>
	<figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
		<span class="font-display text-lg font-bold">{title}</span>
		<span class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-neutral-600">
			<span class="inline-flex items-center gap-2">
				<span aria-hidden="true" class="size-2.5 rounded-full bg-neutral-400"></span>{periods.before}
			</span>
			<span class="inline-flex items-center gap-2">
				<span aria-hidden="true" class="size-2.5 rounded-full bg-brand"></span>{periods.after}
			</span>
		</span>
	</figcaption>

	<div class:list={[isPeriods && "overflow-x-auto"]}>
		<div class:list={[isPeriods && "min-w-170"]}>
			<div
				role="img"
				aria-label={description}
				class:list={["flex items-end border-b border-ink", isPeriods ? "gap-3" : "gap-0.5"]}
				style={`height:${isPeriods ? plotHeight + 60 : plotHeight}px`}
			>
				{bars.map((bar) => (
					<div
						title={isPeriods ? undefined : `${bar.label}: ${bar.value}`}
						class:list={["flex flex-1 flex-col items-center justify-end", isPeriods && "gap-2"]}
					>
						{isPeriods && <span class="font-display text-base font-bold tabular-nums">{bar.value}</span>}
						<div
							class:list={["w-full", isPeriods ? "rounded-t-lg" : "rounded-t-xs", bar.after ? "bg-brand" : "bg-neutral-400"]}
							style={`height:${heightOf(bar.value)}px`}
						>
						</div>
					</div>
				))}
			</div>

			<div aria-hidden="true" class:list={["mt-2 flex text-xs leading-snug text-neutral-600", isPeriods ? "gap-3 text-center" : "gap-0.5"]}>
				{bars.map((bar) => (
					<div class:list={["min-w-0 flex-1", isPeriods ? "text-balance" : "whitespace-nowrap"]}>
						{isPeriods ? bar.label : (bar.tick ?? "")}
					</div>
				))}
			</div>
		</div>
	</div>

	{note && <p class="text-sm text-neutral-600">{note}</p>}
</figure>
