---
// Top of a project page: breadcrumb, pill headline, summary, buttons, fact tiles and tags.
// Built from the same pieces as the homepage hero (texture-grid, headline pill, button-primary).
import type { CollectionEntry } from "astro:content";
import Icon from "../Icon.astro";
import { formatProjectDate } from "../../lib/projectDate";

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const p = project.data;
// Fall back to empty lists so a project saved without these fields still renders.
const facts = p.facts ?? [];
const tags = p.tags ?? [];
const isDraft = p.status === "draft";
// Projects without a split headline fall back to the title, with no pill.
const hasPill = Boolean(p.headlineHighlight);
---

<section id="top" class="texture-grid bg-paper text-ink">
	<div class="container-default pt-32 pb-20 md:pt-40">
		{isDraft && (
			<p class="label mb-6 inline-block rounded-full bg-ink px-3 py-1 text-paper">
				Draft: only visible on your machine
			</p>
		)}

		<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
		<nav aria-label="Breadcrumb">
			<ol class="label flex flex-wrap items-center gap-x-3 gap-y-1 text-neutral-600">
				<li><a href="/projects" class="link">Projects</a></li>
				{p.category && <li class="before:mr-3 before:text-neutral-400 before:content-['/']">{p.category}</li>}
				<li aria-current="page" class="text-ink before:mr-3 before:text-neutral-400 before:content-['/']">{p.title}</li>
			</ol>
		</nav>
		{p.showDate && p.date && (
			<time datetime={p.date.toISOString().slice(0, 10)} class="label text-neutral-600">{formatProjectDate(p.date)}</time>
		)}
		</div>

		<h1 class="mt-6 text-[2rem] leading-[1.2] text-balance max-[375px]:text-[1.625rem] sm:text-5xl" style={`view-transition-name:project-${p.slug}`}>
			{hasPill ? (
				<>
					{p.headlineStart}{" "}
					<span class="inline-block rounded-full bg-ink px-[0.4em] pt-[0.02em] pb-[0.1em] whitespace-nowrap text-paper">{p.headlineHighlight}</span>{" "}
					{p.headlineEnd}
				</>
			) : (
				p.title
			)}
		</h1>

		{p.summary && <p class="mt-6 max-w-5xl text-lg leading-relaxed text-neutral-700 text-pretty">{p.summary}</p>}

		<div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
			<a href="#contact" class="button-primary">
				Get in touch
				<span class="button-dot"><Icon name="arrow-right" class="size-5" /></span>
			</a>
			{p.results && <a href="#results" class="link tap-target active:text-neutral-600">See the results</a>}
		</div>

		{facts.length > 0 && (
			<dl class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				{facts.map((fact) => (
					<div class="rounded-2xl bg-paper-raised px-6 py-4">
						<dt class="label text-neutral-600">{fact.label}</dt>
						<dd class="mt-1 font-display text-lg font-medium">{fact.value}</dd>
					</div>
				))}
			</dl>
		)}

		{tags.length > 0 && (
			<ul aria-label="Skills" class="mt-6 flex flex-wrap gap-2">
				{tags.map((tag) => (
					<li class="rounded-full border border-ink px-3 py-1 text-sm">{tag}</li>
				))}
			</ul>
		)}
	</div>
</section>
