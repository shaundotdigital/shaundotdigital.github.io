---
// Links to the project before and after this one, in the order set by the "order" field.
// Only the sides that exist are shown, so the first project has no "previous".
import Icon from "../Icon.astro";

interface Item {
	title: string;
	slug: string;
	category?: string;
}

interface Props {
	previous?: Item;
	next?: Item;
}

const { previous, next } = Astro.props;
const card =
	"interactive flex flex-col gap-2 rounded-2xl border border-neutral-200 bg-paper-raised p-6 hover:border-ink active:translate-y-px";
---

{(previous || next) && (
	<nav aria-label="More projects" class="texture-grid bg-paper text-ink">
		<div class="container-default grid gap-4 py-16 md:grid-cols-2">
			{previous ? (
				<a href={`/projects/${previous.slug}`} class={card}>
					<span class="label inline-flex items-center gap-2 text-neutral-600">
						<Icon name="arrow-right" class="size-4 rotate-180" />Previous project
					</span>
					<span class="font-display text-2xl leading-snug font-bold">{previous.title}</span>
					{previous.category && <span class="text-sm text-neutral-600">{previous.category}</span>}
				</a>
			) : (
				<span class="hidden md:block"></span>
			)}
			{next && (
				<a href={`/projects/${next.slug}`} class:list={[card, "md:items-end md:text-right"]}>
					<span class="label inline-flex items-center gap-2 text-neutral-600">
						Next project<Icon name="arrow-right" class="size-4" />
					</span>
					<span class="font-display text-2xl leading-snug font-bold">{next.title}</span>
					{next.category && <span class="text-sm text-neutral-600">{next.category}</span>}
				</a>
			)}
		</div>
	</nav>
)}
