---
// The black results band under a project's hero: one big figure, up to three smaller ones.
// Uses theme-inverse like the experience section, so it stays dark in dark mode.
interface Stat {
	value: string;
	label: string;
}

interface Props {
	main: Stat;
	others: Stat[];
}

const { main } = Astro.props;
const others = Astro.props.others ?? [];
---

<section id="results" aria-label="Results" class="theme-inverse bg-ink text-paper">
	<div class="container-default grid items-end gap-12 py-20 lg:grid-cols-2">
		<div>
			<p class="font-display text-7xl leading-none font-bold tracking-tight tabular-nums sm:text-8xl">{main.value}</p>
			<p class="mt-4 max-w-md text-xl leading-relaxed">{main.label}</p>
		</div>

		{others.length > 0 && (
			<dl class="grid grid-cols-1 gap-6 sm:grid-cols-3">
				{others.map((stat) => (
					<div class="flex flex-col-reverse justify-end gap-2 border-t border-paper/15 pt-4">
						<dt class="text-sm leading-relaxed text-paper/70">{stat.label}</dt>
						<dd class="font-display text-3xl font-bold tabular-nums">{stat.value}</dd>
					</div>
				))}
			</dl>
		)}
	</div>
</section>
