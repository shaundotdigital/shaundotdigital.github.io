---
// The two cards above the period chart: one big figure for each period.
// The "after" card is black, the "before" card takes the opposite colour to its section.
interface Card {
	after: boolean;
	dates: string;
	value: string;
	measure: string;
	text?: string;
}

interface Props {
	cards: Card[];
	periods: { before: string; after: string };
	surface: "raised" | "paper";
}

const { cards, periods, surface } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-2">
	{cards.map((card) => (
		<div
			class:list={[
				"flex flex-col gap-2 rounded-2xl p-6",
				card.after ? "theme-inverse bg-ink text-paper" : [surface === "raised" ? "bg-paper-raised" : "bg-paper", "text-ink"],
			]}
		>
			<div class="flex items-center gap-2">
				<span aria-hidden="true" class:list={["size-2.5 rounded-full", card.after ? "bg-brand" : "bg-neutral-500"]}></span>
				<h3 class="font-display text-lg leading-snug font-bold">{card.after ? periods.after : periods.before}</h3>
			</div>
			<p class:list={["text-sm", card.after ? "text-paper/70" : "text-neutral-600"]}>{card.dates}</p>
			<p class="mt-4 font-display text-5xl leading-none font-bold tabular-nums">{card.value}</p>
			<p class:list={["text-sm", card.after ? "text-paper/70" : "text-neutral-600"]}>{card.measure}</p>
			{card.text && (
				<p class:list={["mt-3 text-base leading-relaxed", card.after ? "text-paper/70" : "text-neutral-700"]}>{card.text}</p>
			)}
		</div>
	))}
</div>
