---
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import ProjectHero from "../../components/project/ProjectHero.astro";
import ResultsBand from "../../components/project/ResultsBand.astro";
import ProjectSection from "../../components/project/ProjectSection.astro";
import ColumnChart from "../../components/project/ColumnChart.astro";
import ChangeRows from "../../components/project/ChangeRows.astro";
import PeriodCards from "../../components/project/PeriodCards.astro";
import FindingCards from "../../components/project/FindingCards.astro";
import TweetCard from "../../components/project/TweetCard.astro";
import LessonList from "../../components/project/LessonList.astro";
import Screenshots from "../../components/project/Screenshots.astro";
import SidePicture from "../../components/project/SidePicture.astro";
import WrittenContent from "../../components/project/WrittenContent.astro";
import ProjectNav from "../../components/project/ProjectNav.astro";
import { getProjects } from "../../lib/projects";
import { getProjectImage } from "../../lib/projectImages";

// One page per visible project. In the live build, drafts never reach this list,
// so no page is made for them.
export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project, index) => ({
		params: { slug: project.data.slug },
		props: {
			project,
			previous: projects[index - 1]?.data,
			next: projects[index + 1]?.data,
		},
	}));
}

const { project, previous, next } = Astro.props;
const { results, periods, trend, findings, changes, monthly, brief, built, launch, screenshots, tweets, lessons } = project.data;
const avatarImage = getProjectImage(tweets?.avatarImage, project.data.title);

// Sections alternate between white and the page colour, whichever of them are filled in.
// The tweets band is always black, so it sits outside that pattern.
// The chart card inside takes the opposite colour so it stands out.
const surfaces: Record<string, "raised" | "paper"> = {};
let position = 0;
// A written or screenshot section saved with only a heading counts as empty.
const hasContent = (section?: { items?: unknown[]; text?: string }) => Boolean(section?.items?.length || section?.text?.trim());
const optional = { brief, built, launch, screenshots };
for (const key of ["trend", "brief", "findings", "changes", "monthly", "built", "launch", "screenshots", "lessons"] as const) {
	const filled = key in optional ? hasContent(optional[key as keyof typeof optional]) : Boolean(project.data[key]);
	if (filled) surfaces[key] = position++ % 2 === 0 ? "raised" : "paper";
}
const opposite = (surface: "raised" | "paper") => (surface === "raised" ? "paper" : "raised");
---

<Layout title={project.data.title} description={project.data.summary}>
	<SiteNav />
	<main class="font-sans">
		<ProjectHero project={project} />
		{results && <ResultsBand main={results.main} others={results.others} />}
		{trend && (
			<ProjectSection id="trend" heading={trend.heading} intro={trend.intro} surface={surfaces.trend}>
				{trend.cards.length > 0 && <PeriodCards cards={trend.cards} periods={periods} surface={opposite(surfaces.trend)} />}
				<ColumnChart
					variant="periods"
					title={trend.title}
					alt={trend.alt}
					note={trend.note}
					pausedLabel={trend.pausedLabel}
					bars={trend.bars}
					periods={periods}
					surface={opposite(surfaces.trend)}
				/>
			</ProjectSection>
		)}
		{brief && hasContent(brief) && (
			<ProjectSection id="brief" heading={brief.heading} intro={brief.intro} surface={surfaces.brief} split={Boolean(brief.picture?.image)}>
				<WrittenContent items={brief.items} text={brief.text} stacked={Boolean(brief.picture?.image)} />
				{brief.picture?.image && <SidePicture slot="aside" picture={brief.picture} project={project.data.title} />}
			</ProjectSection>
		)}
		{findings && (
			<ProjectSection id="findings" heading={findings.heading} intro={findings.intro} surface={surfaces.findings}>
				<FindingCards cards={findings.cards} surface={opposite(surfaces.findings)} equalHeight={findings.equalHeight} />
			</ProjectSection>
		)}
		{changes && (
			<ProjectSection id="changes" heading={changes.heading} intro={changes.intro} surface={surfaces.changes}>
				<ChangeRows rows={changes.rows} periods={periods} />
			</ProjectSection>
		)}
		{monthly && (
			<ProjectSection id="monthly" heading={monthly.heading} intro={monthly.intro} surface={surfaces.monthly}>
				<ColumnChart
					variant="months"
					title={monthly.title}
					alt={monthly.alt}
					note={monthly.note}
					pausedLabel={monthly.pausedLabel}
					bars={monthly.bars}
					periods={periods}
					surface={opposite(surfaces.monthly)}
				/>
			</ProjectSection>
		)}
		{built && hasContent(built) && (
			<ProjectSection id="built" heading={built.heading} intro={built.intro} surface={surfaces.built} split={Boolean(built.picture?.image)}>
				<WrittenContent items={built.items} text={built.text} stacked={Boolean(built.picture?.image)} />
				{built.picture?.image && <SidePicture slot="aside" picture={built.picture} project={project.data.title} />}
			</ProjectSection>
		)}
		{launch && hasContent(launch) && (
			<ProjectSection id="launch" heading={launch.heading} intro={launch.intro} surface={surfaces.launch} split={Boolean(launch.picture?.image)}>
				<WrittenContent items={launch.items} text={launch.text} stacked={Boolean(launch.picture?.image)} />
				{launch.picture?.image && <SidePicture slot="aside" picture={launch.picture} project={project.data.title} />}
			</ProjectSection>
		)}
		{screenshots && hasContent(screenshots) && (
			<ProjectSection id="screenshots" heading={screenshots.heading} intro={screenshots.intro} surface={surfaces.screenshots}>
				<Screenshots items={screenshots.items} project={project.data.title} />
			</ProjectSection>
		)}
		{tweets && tweets.items.length > 0 && (
			<ProjectSection id="tweets" heading={tweets.heading} intro={tweets.intro} surface="ink">
				<div class:list={["grid gap-4 md:grid-cols-2 lg:grid-cols-3", tweets.equalHeight ? "items-stretch" : "items-start"]}>
					{tweets.items.map((item) => (
						<TweetCard author={tweets.author} handle={tweets.handle} avatar={tweets.avatar} avatarImage={avatarImage} {...item} />
					))}
				</div>
			</ProjectSection>
		)}
		{lessons && (
			<ProjectSection id="lessons" heading={lessons.heading} surface={surfaces.lessons}>
				<LessonList items={lessons.items} />
				{lessons.note && <p class="max-w-3xl text-sm leading-relaxed text-neutral-600">{lessons.note}</p>}
			</ProjectSection>
		)}
		<ProjectNav previous={previous} next={next} />
	</main>
</Layout>
