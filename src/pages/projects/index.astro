---
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { Image } from "astro:assets";
import { getProjects } from "../../lib/projects";
import { getProjectImage } from "../../lib/projectImages";
import { formatProjectDate } from "../../lib/projectDate";

const projects = await getProjects();

// On the live site, with nothing published yet, send visitors home instead of showing an empty page.
if (import.meta.env.PROD && projects.length === 0) return Astro.redirect("/");
---

<Layout title="Projects" description="Case studies from my work, with what changed and the numbers behind it.">
	<SiteNav />
	<main class="font-sans">
		<section id="projects" class="texture-grid bg-paper text-ink">
			<div class="container-default pt-32 pb-20 md:pt-40">
				<h1 class="max-w-3xl text-[2rem] leading-[1.2] sm:text-5xl">Projects</h1>
				<p class="mt-6 max-w-2xl text-xl leading-relaxed text-neutral-700 text-pretty">
					Case studies from my work, with what changed and the numbers behind it.
				</p>

				{projects.length > 0 ? (
					<ul class="mt-12 grid gap-4 md:grid-cols-2">
						{projects.map(({ data }) => {
							const image = getProjectImage(data.image, data.title);
							return (
								<li>
									<a
										href={`/projects/${data.slug}`}
										data-astro-prefetch="hover"
										class="interactive flex h-full flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-paper-raised hover:border-ink active:translate-y-px"
									>
										{image && (
											<Image
												src={image}
												alt={data.imageAlt ?? ""}
												widths={[480, 720, 960]}
												sizes="(min-width: 768px) 560px, 100vw"
												class="aspect-[16/10] w-full object-cover"
											/>
										)}
										<div class="flex flex-1 flex-col gap-4 p-6">
											<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
												{data.category && <span class="label text-neutral-600">{data.category}</span>}
												{data.showDate && data.date && (
													<time datetime={data.date.toISOString().slice(0, 10)} class="label text-neutral-600">
														{formatProjectDate(data.date)}
													</time>
												)}
												{data.status === "draft" && (
													<span class="label rounded-full bg-ink px-3 py-1 text-paper">Draft</span>
												)}
											</div>
											<h2 class="font-display text-2xl leading-snug font-bold">{data.title}</h2>
											{data.summary && <p class="text-base leading-relaxed text-neutral-700">{data.summary}</p>}
											{data.results && (
												<p class="mt-auto flex items-baseline gap-3 border-t border-neutral-200 pt-4">
													<span class="font-display text-3xl font-bold tabular-nums">{data.results.main.value}</span>
													<span class="text-sm text-neutral-600">{data.results.main.label}</span>
												</p>
											)}
										</div>
									</a>
								</li>
							);
						})}
					</ul>
				) : (
					<p class="mt-12 text-lg text-neutral-700">Nothing here yet.</p>
				)}
			</div>
		</section>
	</main>
</Layout>
