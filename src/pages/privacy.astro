---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
// The page text lives in src/data/privacy.md, which Pages CMS edits.
import { frontmatter, compiledContent } from '../data/privacy.md';

// Markdown gives each heading an id. A heading called Contact would clash with the
// contact section's id on this page, so the ids are removed.
const body = (await compiledContent()).replace(/ id="[^"]*"/g, '');
---

<Layout title={frontmatter.title} description={frontmatter.description}>
	<SiteNav />
	<main class="bg-paper font-sans text-neutral-800">
		<!-- Top padding clears the nav, which sits over the page -->
		<div class="container-default pt-40 pb-20">
		<!-- Markdown comes out as plain h2, p and ul tags, so they're styled from here -->
		<div class="max-w-2xl space-y-6 [&_h2]:text-xl [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6">
			<h1 class="text-[2rem] leading-[1.2] sm:text-5xl">{frontmatter.title}</h1>
			<Fragment set:html={body} />
		</div>
		</div>
	</main>
</Layout>
